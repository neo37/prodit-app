<?xml version="1.0" encoding="utf-8"?>
<!-- Production IT (com.prodit.meet): свой первый экран (вход по email), звонки LiveKit; без плеера, установки APK и «поделиться в плеер» -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- 1.0: звонок без службы переднего плана (FGS microphone|camera вернуть в 1.1 вместе с LkCall.BACKGROUND и видео для декларации Play) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" tools:node="remove" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" tools:node="remove" />
    <!-- демонстрация экрана LiveKit пока не нужна (иначе в Play — декларация mediaProjection) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROCESSING" tools:node="remove" />

    <application>
        <receiver android:name="online.magicbtn.player.InstallReceiver" tools:node="remove" />
        <service android:name="online.magicbtn.player.Busy" tools:node="remove" />
        <service android:name="io.livekit.android.room.track.screencapture.ScreenCaptureService" tools:node="remove" />
        <activity android:name="online.magicbtn.player.AddSourceActivity" tools:node="remove" />
        <activity android:name="online.magicbtn.player.ShareInActivity" tools:node="remove" />
        <activity android:name="online.magicbtn.player.GameActivity" tools:node="remove" />
        <activity android:name="online.magicbtn.player.VideoListActivity" android:exported="false" tools:replace="android:exported">
            <intent-filter tools:node="removeAll" />
        </activity>

        <activity
            android:name="online.magicbtn.player.ProditLoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name="online.magicbtn.player.ProditHomeActivity" android:exported="false" />
        <activity android:name="online.magicbtn.player.ProditMeetingsActivity" android:exported="false" />
        <activity android:name="online.magicbtn.player.ProditTeamActivity" android:exported="false" />
        <activity
            android:name="online.magicbtn.player.LkCallActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden" />
        <!-- <service android:name="online.magicbtn.player.LkCallService" android:exported="false" android:foregroundServiceType="microphone|camera" /> — 1.1 -->
    </application>
</manifest>
